{
  "extends": ["ultracite/biome/core"],
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["!packages/pi-ui-messages/prototypes"]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedPackageJson": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "suspicious": {
        "useAwait": "off"
      }
    }
  }
}
