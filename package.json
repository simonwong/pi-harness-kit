{
  "name": "pi-harness-kit",
  "version": "0.0.0",
  "description": "pi harness kit",
  "type": "module",
  "keywords": [
    "pi-harness-kit"
  ],
  "author": "Simon <wsj_simon@163.com>",
  "scripts": {
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm check && pnpm typecheck && pnpm test"
  },
  "pi": {
    "extensions": [
      "./packages/pi-ui-status/src/index.ts",
      "./packages/pi-ui-input/src/index.ts",
      "./packages/pi-ui-messages/src/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "typebox": "^1.3.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "ultracite": "7.10.5",
    "vitest": "4.1.9"
  },
  "packageManager": "pnpm@10.33.4"
}
